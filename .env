# Copie para ".env" (gitignored) e ajuste as senhas. Nunca commitar o .env real.
 
# --- Oracle (gvenzl/oracle-free) ---
ORACLE_PASSWORD=DevLocal_2025!
APP_USER=CONTROLE                          # usuario criado pela imagem = schema "controle";
                                            # tambem e quem o backend usa para conectar
APP_USER_PASSWORD=DevLocal_2025!
SCHEMA_PASSWORD=DevLocal_2025!
                                            # (bronze, silver, gold, quarentena, quartz, batch)
ORACLE_PORT=1521
 
# --- Portas expostas no host ---
BACKEND_PORT=8080
FRONTEND_PORT=5173
KEYCLOAK_PORT=8180

# --- Keycloak (login/RBAC, so desenvolvimento local) ---
# Senha do console administrativo do Keycloak (http://localhost:8180, usuario "admin")
KEYCLOAK_ADMIN_PASSWORD=DevLocal_2025!
# Precisa bater com o "secret" do client datagis-backend em infra/keycloak/realm-datagis.json
KEYCLOAK_BACKEND_CLIENT_SECRET=datagis-backend-dev-secret
# --- GeoServer (mapa de cobertura, LIZARDS-35, so desenvolvimento local) ---
# Painel em http://localhost:8085/geoserver (usuario "admin"). O navegador nao fala
# com ele direto - so pelo proxy do backend.
GEOSERVER_ADMIN_PASSWORD=DevLocal_GeoServer_2026
GEOSERVER_PORT=8085
