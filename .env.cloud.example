# Copie para ".env.cloud" (gitignored) e ajuste. Nunca commitar o .env.cloud real nem a
# pasta wallet/ - sao credenciais de um recurso real na internet (Autonomous AI Database
# "datagis"), diferente do .env local (esse sim rastreado de proposito - CLAUDE.md §4.6).
# Ver docs/analise-hospedagem-autonomous-database-2026-09-22.md §5.2/§5.3.

# --- Autonomous AI Database "datagis" (Always Free) ---
# CLOUD_TNS_NAME: perfil de conexao do tnsnames.ora da wallet (high/medium/low/tp/tpurgent)
CLOUD_TNS_NAME=datagis_high
CLOUD_DB_USERNAME=ADMIN
CLOUD_DB_PASSWORD=troque_a_senha_admin_da_instancia
# TNS_ADMIN: caminho ate a pasta onde a wallet foi extraida
TNS_ADMIN=./wallet
