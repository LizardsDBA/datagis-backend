# Imagem de desenvolvimento: roda o Maven com o codigo montado do host, nao
# empacota nada. So JDK + o mvnw do projeto (ele baixa o Maven sozinho).
# Dockerfile de producao (multi-stage) fica pra quando tiver deploy de verdade.
FROM eclipse-temurin:21-jdk-jammy

WORKDIR /app

# ~/.m2 fica em volume nomeado pra nao baixar tudo de novo a cada subida.
EXPOSE 8080

CMD ["./mvnw", "spring-boot:run"]
